{
  "name": "zenncore",
  "private": true,
  "author": {
    "name": "zennit",
    "email": "zennit.dev@gmail.com",
    "url": "https://www.zennit.dev/"
  },
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=./apps/web...",
    "build:mobile": "turbo run build --filter=./apps/mobile...",
    "build:packages": "turbo build --filter=@zenncore/*",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=./apps/web...",
    "dev:mobile": "turbo run dev --filter=./apps/mobile...",
    "dev:packages": "turbo dev --filter=@zenncore/*",
    "lint": "biome check --write",
    "typecheck": "turbo run typecheck",
    "outdated": "turbo run outdated && bun outdated -r",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@turbo/gen": "^2.8.19",
    "turbo": "^2.8.20"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/shared/*"
    ],
    "catalog": {
      "@hookform/resolvers": "^5.2.2",
      "@tailwindcss/postcss": "^4.2.2",
      "@types/node": "^25.5.0",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "react": "^19.2.3",
      "react-hook-form": "^7.69.0",
      "tailwindcss": "^4.2.2",
      "tsdown": "^0.21.4",
      "typescript": "^5.9.3",
      "zod": "^4.2.1"
    },
    "catalogs": {
      "mobile": {
        "@types/react": "~19.2.14",
        "expo": "~55.0.7",
        "react": "19.1.0",
        "react-native": "0.81.5",
        "uniwind": "^1.5.0"
      }
    }
  }
}
