{
  "name": "zenncore",
  "private": true,
  "author": {
    "name": "zennit",
    "email": "zennit.dev@gmail.com",
    "url": "https://www.zennit.dev/"
  },
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=./apps/web...",
    "build:mobile": "turbo run build --filter=./apps/mobile...",
    "build:packages": "turbo build --filter=@zenncore/*",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=./apps/web...",
    "dev:mobile": "turbo run dev --filter=./apps/mobile...",
    "dev:packages": "turbo dev --filter=@zenncore/*",
    "test": "cd apps/web && bun test src",
    "lint": "biome check --write",
    "typecheck": "turbo run typecheck",
    "outdated": "turbo run outdated && bun outdated -r",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@turbo/gen": "^2.9.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "turbo": "^2.9.18"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "packageManager": "bun@1.3.12",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/shared/*"
    ],
    "catalog": {
      "@hookform/resolvers": "^5.4.0",
      "@tailwindcss/postcss": "^4.3.1",
      "@types/node": "^25.9.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "react": "^19.2.7",
      "react-hook-form": "^7.80.0",
      "tailwindcss": "^4.3.1",
      "tsdown": "^0.22.3",
      "typescript": "^6.0.3",
      "zod": "^4.4.3"
    }
  }
}
