# Existing PostgreSQL database containing staff identities and outbound_* tables.
DATABASE_URL=
# Use a separate random secret for this application.
BETTER_AUTH_SECRET=
BETTER_AUTH_BASE_URL=http://localhost:3001
APP_HOST=http://localhost:3001

# Optional environment fallbacks; prefer provider setup in Integrations.
# Sending stays paused until configured in the app.
OUTBOUND_APOLLO_API_KEY=
OUTBOUND_CLAY_API_KEY=
OUTBOUND_CLAY_ROUTINE_ID=
# Unipile V2 Global/Scoped Account keys work; Service keys are also supported.
# Saved keys are encrypted with CREDENTIAL_ENCRYPTION_KEY and take precedence.
OUTBOUND_UNIPILE_API_KEY=
OUTBOUND_GOOGLE_CLIENT_ID=
OUTBOUND_GOOGLE_CLIENT_SECRET=
# Google callback is derived from APP_HOST and displayed in Integrations.
CRON_SECRET=

# Required for saving provider keys and Gmail grants. Preserve the shared key.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

AZURE_RESOURCE_NAME=
AZURE_API_KEY=
AZURE_API_VERSION=
AZURE_DEPLOYMENT_GPT=

# Optional alternatives to the encrypted Claude key form in Integrations.
OUTBOUND_CLAUDE_API_KEY=
OUTBOUND_CLAUDE_WORKSPACE_ID=

# Optional: isolated disposable LOCAL database for transaction tests. Never use
# DATABASE_URL or a live workspace database here; tests recreate fixture tables.
OUTBOUND_TEST_DATABASE_URL=
