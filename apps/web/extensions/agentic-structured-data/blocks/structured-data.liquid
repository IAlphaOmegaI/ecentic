{%- comment -%}
  App embed block: renders Ecentic's ucp.* metafields as JSON-LD in the page
  head so crawling AI agents can read them. Falls back to deterministic
  markup built from live product data when the metafield is absent, so the
  structured data can never disagree with the page it sits on.
{%- endcomment -%}

{%- if block.settings.render_product_jsonld and template contains 'product' and product -%}
  {%- assign structured = product.metafields.ucp.structured_data -%}
  <script type="application/ld+json">
    {%- if structured != blank -%}
      {{ structured.value | json }}
    {%- else -%}
      {%- assign variant = product.selected_or_first_available_variant -%}
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | json }},
        "description": {{ product.description | strip_html | truncate: 500 | json }},
        "url": {{ request.origin | append: product.url | json }},
        {%- if product.featured_image -%}
          "image": {{ product.featured_image | image_url: width: 1200 | json }},
        {%- endif -%}
        {%- if product.vendor != blank -%}
          "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
        {%- endif -%}
        {%- if variant.sku != blank -%}
          "sku": {{ variant.sku | json }},
        {%- endif -%}
        {%- if variant.barcode != blank -%}
          "gtin": {{ variant.barcode | json }},
        {%- endif -%}
        "offers": {
          "@type": "Offer",
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
          "url": {{ request.origin | append: variant.url | json }}
        }
      }
    {%- endif -%}
  </script>
{%- endif -%}

{%- if block.settings.render_org_jsonld and template == 'index' -%}
  {%- assign profile = shop.metafields.ucp.merchant_profile -%}
  <script type="application/ld+json">
    {%- if profile != blank -%}
      {{ profile.value | json }}
    {%- else -%}
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}
      }
    {%- endif -%}
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Agentic structured data",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "render_product_jsonld",
      "label": "Product JSON-LD",
      "info": "Disable if your theme already outputs schema.org Product markup.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "render_org_jsonld",
      "label": "Organization JSON-LD (homepage)",
      "default": true
    }
  ]
}
{% endschema %}
