{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/loop",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/loop-maintenance",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/recharge",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/recharge-maintenance",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/recharge-checks",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/drain",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/google-merchant",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/blog",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/offers",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/blog-translations",
      "schedule": "* * * * *"
    }
  ]
}
