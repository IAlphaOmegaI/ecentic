# Copy this file to .env.local and fill in the values.
# Generate secrets with: openssl rand -base64 32

# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/ecentic

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=          # generate: openssl rand -base64 32
BETTER_AUTH_BASE_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=

# --- Shopify integration ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# --- Storage (UploadThing) ---
UPLOADTHING_TOKEN=

# --- AI (Azure) ---
AZURE_RESOURCE_NAME=
AZURE_API_KEY=
AZURE_BASE_URL=
# Deployment serving ChatGPT on that resource — the DEPLOYMENT's name, not the
# model's (list them with: curl "https://$AZURE_RESOURCE_NAME.openai.azure.com/openai/deployments?api-version=2023-03-15-preview" -H "api-key: $AZURE_API_KEY").
# Leave empty and the `gpt` seat resolves through the gateway instead of 404ing.
AZURE_DEPLOYMENT_GPT=

# --- AI (Vercel AI Gateway) — Claude, Gemini, Perplexity, and GPT's fallback ---
AI_GATEWAY_API_KEY=

# --- Monitoring ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Analytics (PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Support (Chatwoot) ---
NEXT_PUBLIC_CHATWOOT_BASE_URL=
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=

# --- Cron ---
CRON_SECRET=                 # generate: openssl rand -base64 32

# --- Web Bot Auth (HTTP Message Signatures) ---
# Private Ed25519 JWK (JSON). Public key is published at
# /.well-known/http-message-signatures-directory. Required only when this
# origin signs outbound bot/agent requests (Signature / Signature-Input).
WEB_BOT_AUTH_PRIVATE_JWK=

# --- x402 agent payments (@x402/next on GET /api) ---
# EVM address that receives USDC when agents pay for /api access.
# Discovery still works with the zero-address fallback; set a real wallet
# before enabling settlement.
X402_PAY_TO=
# Optional. Defaults to https://x402.org/facilitator (Base Sepolia only).
# For Base mainnet use the CDP facilitator + API keys:
#   X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
#   X402_NETWORK=eip155:8453
# X402_FACILITATOR_URL=
# Optional CAIP-2 network. Defaults to eip155:84532 (Base Sepolia).
# X402_NETWORK=

# --- Tracking ---
APP_HOST=
ECENTIC_TRACKER_PUBLIC_ORIGIN=
ECENTIC_TRACKER_PROBE=

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_READ_ONLY_TOKEN=
UPSTASH_REDIS_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SUB_COMPETE=
STRIPE_SUB_DOMINATE=
# Partner deal coupon ids (e.g. 50% off for 24 months). Create in Stripe, paste id here.
STRIPE_DEAL_COUPON_YC=
STRIPE_DEAL_COUPON_TECHSTARS=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ScrapeLLM (dev — /dev/llm-scraping sandbox) ---
# Key from https://scrapellm.com. 3 credits per capture (cache hits observed to bill 0).
SCRAPELLM_API_KEY=
