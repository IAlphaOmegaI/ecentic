# Copy this file to .env.local and fill in the values.
# Generate secrets with: openssl rand -base64 32

# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/ecentic

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=          # generate: openssl rand -base64 32
BETTER_AUTH_BASE_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=

# --- Shopify integration ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# --- Recharge partner app (read-only commerce data) ---
RECHARGE_CLIENT_ID=
RECHARGE_CLIENT_SECRET=
RECHARGE_REDIRECT_URI=http://localhost:3000/api/integrations/recharge/callback
# Existing credential encryption, shared by all provider grants.
CREDENTIAL_ENCRYPTION_KEY=   # generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# --- Loop (per-store, read-only returns) ---
# Merchant API keys and signing secrets are entered in Settings and encrypted in
# the database. Never put a shared merchant key here.
LOOP_OAUTH_ENABLED=0
LOOP_CLIENT_ID=
LOOP_CLIENT_SECRET=
LOOP_REDIRECT_URI=http://localhost:3000/api/integrations/loop/callback
# TODO(loop-confirm): returns scopes and PKCE support. Leave unset/OAuth disabled.
LOOP_OAUTH_SCOPES=
LOOP_GAP_MIN_RETURNS=5
LOOP_GAP_MIN_SHARE=0.2
LOOP_GAP_WINDOW_DAYS=60
# Daily maximum real AI answer captures for each consenting store (two per gap).
LOOP_DAILY_CAPTURE_LIMIT=20

# --- Storage (UploadThing) ---
UPLOADTHING_TOKEN=

# --- AI (Azure) ---
AZURE_RESOURCE_NAME=
AZURE_API_KEY=
AZURE_BASE_URL=
# Deployment serving ChatGPT on that resource — the DEPLOYMENT's name, not the
# model's (list them with: curl "https://$AZURE_RESOURCE_NAME.openai.azure.com/openai/deployments?api-version=2023-03-15-preview" -H "api-key: $AZURE_API_KEY").
# Leave empty and the `gpt` seat resolves through the gateway instead of 404ing.
AZURE_DEPLOYMENT_GPT=

# --- AI (Vercel AI Gateway) — Claude, Gemini, Perplexity, and GPT's fallback ---
AI_GATEWAY_API_KEY=

# --- Monitoring ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Analytics (PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Analytics (Google Analytics 4) ---
# Measurement ID from GA4 Admin → Data streams → Web (format: G-XXXXXXXXXX).
# Runs alongside PostHog; leave empty to omit the gtag script entirely, which
# is what keeps local and preview traffic out of the property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Support (Chatwoot) ---
NEXT_PUBLIC_CHATWOOT_BASE_URL=
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=

# --- Blog (BabyLoveGrowth CMS) ---
# Integration key from BabyLoveGrowth → Settings → Integrations → Next.js Blog.
# Keep server-side only — never prefix with NEXT_PUBLIC_.
BABYLOVEGROWTH_BLOG_API_KEY=
# Optional override (defaults to production). e.g. http://localhost:8000/api/integrations/v1
BABYLOVEGROWTH_BLOG_API_URL=

# --- Cron ---
CRON_SECRET=                 # generate: openssl rand -base64 32
DEV_DISCOVERY_TOKEN=         # access code for GET /api/dev/discovery; required in production

# --- Web Bot Auth (HTTP Message Signatures) ---
# Private Ed25519 JWK (JSON). Public key is published at
# /.well-known/http-message-signatures-directory. Required only when this
# origin signs outbound bot/agent requests (Signature / Signature-Input).
WEB_BOT_AUTH_PRIVATE_JWK=

# --- x402 agent payments (@x402/next on GET /api) ---
# EVM address that receives USDC when agents pay for /api access.
# Discovery still works with the zero-address fallback; set a real wallet
# before enabling settlement.
X402_PAY_TO=
# Optional. Defaults to https://x402.org/facilitator (Base Sepolia only).
# For Base mainnet use the CDP facilitator + API keys:
#   X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
#   X402_NETWORK=eip155:8453
# X402_FACILITATOR_URL=
# Optional CAIP-2 network. Defaults to eip155:84532 (Base Sepolia).
# X402_NETWORK=

# --- Tracking ---
APP_HOST=
ECENTIC_TRACKER_PUBLIC_ORIGIN=
ECENTIC_TRACKER_PROBE=

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_READ_ONLY_TOKEN=
UPSTASH_REDIS_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring price ids, cheapest first. Dominate is the top tier and the one
# partner deals are redeemed against.
STRIPE_SUB_COMPETE=
STRIPE_SUB_SCALE=
STRIPE_SUB_DOMINATE=
# Partner deal coupon ids. Terms live in the Stripe coupon object — do not
# restate them here; a stale figure in a comment gets quoted to a founder.
# Both coupons are restricted to the Dominate product.
STRIPE_DEAL_COUPON_YC=
STRIPE_DEAL_COUPON_TECHSTARS=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ScrapeLLM (dev — /dev/llm-scraping sandbox) ---
# Key from https://scrapellm.com. 3 credits per capture (cache hits observed to bill 0).
SCRAPELLM_API_KEY=

# --- Public agent storefront (/agents) ---
# Optional. Reads stores that block plain requests; unset falls back to the sitemap walk.
FIRECRAWL_API_KEY=
# The one store /agents may publish to Merchant Center for. Unset means nothing is eligible, ever.
AGENTS_DEMO_DOMAIN=
