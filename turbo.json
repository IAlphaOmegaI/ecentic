{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "APP_VARIANT",
    "EAS_BUILD",
    "ECENTIC_TRACKER_PUBLIC_ORIGIN",
    "ECENTIC_TRACKER_PROBE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "UPLOADTHING_TOKEN",
        "BETTER_AUTH_BASE_URL",
        "CRON_SECRET",
        "RESEND_API_KEY",
        "FROM_EMAIL",
        "SHOPIFY_API_KEY",
        "SHOPIFY_API_SECRET",

        "AZURE_RESOURCE_NAME",
        "AZURE_API_KEY",
        "AZURE_BASE_URL",
        "APP_HOST",
        "ECENTIC_TRACKER_PUBLIC_ORIGIN",
        "ECENTIC_TRACKER_PROBE",
        "npm_package_name",
        "npm_package_version",
        "SENTRY_AUTH_TOKEN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NODE_ENV",
        "CI",
        "UPSTASH_REDIS_REST_READ_ONLY_TOKEN",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_SUB_COMPETE",
        "STRIPE_SUB_DOMINATE",
        "STRIPE_DEAL_COUPON_YC",
        "STRIPE_DEAL_COUPON_TECHSTARS",
        "PERFORMANCE_FEE_RATE_BPS_DEFAULT",
        "PERFORMANCE_FEE_CAP_CENTS_DEFAULT",
        "PERFORMANCE_FEE_ATTRIBUTION_WINDOW_DAYS",
        "UCP_SIGNING_PRIVATE_KEY",
        "SHOPIFY_CATALOG_CLIENT_ID",
        "SHOPIFY_CATALOG_CLIENT_SECRET",
        "SHOPIFY_CATALOG_TOKEN_URL",
        "SHOPIFY_CATALOG_MCP_URL",
        "UCP_AGENT_PROFILE_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint": {
      "cache": false
    },
    "outdated": {
      "cache": false,
      "interactive": true
    },
    "clean": {
      "cache": false
    }
  }
}
