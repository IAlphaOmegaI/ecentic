{
  "pkg": "@zenncore/web",
  "globalName": "ZennWeb",
  "shape": "package",
  "projectId": "3e3e4e57-0029-4178-a56f-13b03cc05fd0",
  "buildCmd": "bun run build:packages && node .design-sync/gen-entry.mjs && ./.ds-sync/node_modules/.bin/tailwindcss -i .design-sync/tailwind-input.css -o packages/web/dist/ds-tailwind.css",
  "cssEntry": "dist/ds-tailwind.css",
  "docsDir": "../../.design-sync/docs",
  "readmeHeader": ".design-sync/conventions.md",
  "componentSrcMap": {
    "Carousel": null
  },
  "overrides": {
    "Dialog": { "cardMode": "single", "viewport": "560x440" },
    "AlertDialog": { "cardMode": "single", "viewport": "560x440" },
    "Sheet": { "cardMode": "single", "viewport": "760x520" },
    "Popover": { "cardMode": "single", "viewport": "560x440" },
    "Tooltip": { "cardMode": "single", "viewport": "480x320" },
    "PreviewCard": { "cardMode": "single", "viewport": "560x440" },
    "DropdownMenu": { "cardMode": "single", "viewport": "560x480" },
    "ContextMenu": { "cardMode": "single", "viewport": "560x480" },
    "Menu": { "cardMode": "single", "viewport": "560x480" },
    "Command": { "cardMode": "single", "viewport": "620x520" },
    "NavigationMenu": { "cardMode": "single", "viewport": "760x480" },
    "Select": { "cardMode": "single", "viewport": "560x480" },
    "Combobox": { "cardMode": "single", "viewport": "560x520" },
    "Autocomplete": { "cardMode": "single", "viewport": "560x520" },
    "Table": { "cardMode": "column" },
    "DataTable": { "cardMode": "column" },
    "Toolbar": { "cardMode": "column" },
    "Accordion": { "cardMode": "column" },
    "Collapsible": { "cardMode": "column" },
    "Fieldset": { "cardMode": "column" },
    "Form": { "cardMode": "column" },
    "InferredForm": { "cardMode": "column" },
    "FileUpload": { "cardMode": "column" },
    "Textarea": { "cardMode": "column" },
    "ScrollArea": { "cardMode": "column" },
    "Separator": { "cardMode": "column" },
    "Pagination": { "cardMode": "column" },
    "Tabs": { "cardMode": "column" },
    "Meter": { "cardMode": "single", "primaryStory": "WinRate" },
    "Progress": { "cardMode": "single", "primaryStory": "Simulating" }
  }
}
